    "source": "Natural Earth 110m admin-0 (public domain)",
    "truth": {
      "greenland_km2": 2166086,
      "africa_km2": 30370000,
      "ratio": 14.0,
      "crossCheck": "our rendered polygons independently give 2,190,043 / 29,887,668 = 13.6x (110m generalization); both round to 'about fourteen', which is what the VO claims"
    },
    "lie": {
      "africa_over_greenland_as_drawn": 0.92,
      "note": "measured by shoelace over the PROJECTED polygons: Africa's on-screen area is only 0.92x Greenland's, so Greenland genuinely looks BIGGER than Africa on Mercator"
    },
    "inflation": {
      "Greenland": 16.2,
      "note": "MEASURED BY THE COMPOSITION at render time (projected area at Greenland's real latitude / projected area of the same polygon transported to the equator) — this is the number the on-screen counter runs down from. An earlier scratch calculation said 14.8 because it normalised against AFRICA's own inflation (Africa spans 35N-35S, so it is not itself an unbiased 1.0 baseline); 16.2 is the equator-referenced truth and is what the code and the screen agree on.",
      "Canada_theoretical": 4.0,
      "Russia_theoretical": 4.5,
      "theoreticalNote": "local area inflation is 1/cos^2(lat); Canada and Russia are not measured on screen, only shown deflating"
